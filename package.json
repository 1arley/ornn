{
  "name": "ornn-forge",
  "version": "1.4.1",
  "description": "Portable skill library, knowledge base and deterministic tooling for AI coding agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ornn": "./bin/cli.js",
    "ornn-forge": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "patterns/",
    "recipes/",
    "collections/",
    "commands/",
    "integrations/",
    "detectors/",
    "dist/",
    "references/",
    "templates/",
    "examples/",
    "docs/",
    "scripts/*.py",
    "scripts/build/",
    "catalog/",
    "evals/",
    "src/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/prompts.test.js test/cli.test.js test/universal-installer.test.js test/library.test.js && python3 -m unittest discover -s test -p 'test_*.py'",
    "validate": "python3 scripts/validate.py",
    "eval": "python3 scripts/eval.py route --router v2 --check",
    "build": "node bin/cli.js build",
    "detect": "node detectors/run.js"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "audit",
    "security",
    "reliability",
    "code-review",
    "bug-finding",
    "evals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1arley/ornn.git"
  },
  "bugs": {
    "url": "https://github.com/1arley/ornn/issues"
  },
  "homepage": "https://github.com/1arley/ornn#readme"
}
