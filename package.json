{
  "name": "agent-engineering-skills",
  "version": "1.0.1",
  "description": "Modular skills that teach AI agents to audit systems, find bugs, review UX/frontend, and research before reinventing. npx agent-engineering-skills install",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-engineering-skills": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "references/",
    "templates/",
    "examples/",
    "docs/",
    "scripts/",
    "catalog/",
    "evals/",
    "src/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/cli.test.js && python3 -m unittest discover -s test -p 'test_*.py'",
    "validate": "python3 scripts/validate.py",
    "eval": "python3 scripts/eval.py route --router v2 --check"
  },
  "keywords": [
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "audit",
    "security",
    "reliability",
    "code-review",
    "bug-finding",
    "evals"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1arley/1arley-agent-skills.git"
  },
  "bugs": {
    "url": "https://github.com/1arley/1arley-agent-skills/issues"
  },
  "homepage": "https://github.com/1arley/1arley-agent-skills#readme"
}
